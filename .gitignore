# Dependencies
node_modules/
# Build output
dist/
dist-electron/
dist-test/
# electron-builder output (installer / unpacked app)
release/
# 临时输出目录（release/win-unpacked 被占用时的绕开目录，见 electron-builder.yml）
release-tmp/
release-clean/
release-win/
# WorkBuddy project data (personal config, do NOT commit)
.workbuddy/
# Local data / secrets
*.db
*.db-wal
*.db-shm
userData/
.env
.env.*
# Logs / temp probes
*.log
.a*.log
# 回归/类型检查的日志落盘（Windows 上 stdout 常丢，只能写文件再读）
*.out.txt
# Local verification artifacts (electron screenshots / probes)
/canvas-screenshot.png
/export-html-screenshot.png
/ui-*.png
probe-*.cjs
# OS
Thumbs.db
Desktop.ini

# CI 工作流模板放在 docs/ci/（真正的 .github/workflows 需要 PAT 的 workflow scope 才能推，
# 本机缓存的 token 没有该 scope，一推就会被整批拒回）。别用 git add -A 把它带回来。
/.github/
